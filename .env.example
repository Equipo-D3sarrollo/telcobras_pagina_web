# Copia este archivo como .env.local (desarrollo) y rellena los valores.
# En Cloudflare, configúralas como variables/secretos del Worker. No subas valores reales.

# --- Formulario de contacto (/api/contacto) ---

# URL del proyecto de Supabase (https://<id>.supabase.co). Solo la usa el servidor.
SUPABASE_URL=

# Clave service_role de Supabase para insertar en la tabla solicitudes_contacto.
# Tiene privilegios elevados: solo en el servidor, nunca en variables VITE_*.
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta de Cloudflare Turnstile para validar el token en el servidor.
# Si falta, el formulario responde 503 (fail-closed).
TURNSTILE_SECRET_KEY=

# Clave pública (site key) de Cloudflare Turnstile para dibujar el widget en el navegador.
# Si falta, el formulario se muestra deshabilitado con un aviso.
VITE_TURNSTILE_SITE_KEY=

# Hostnames desde los que se acepta un token de Turnstile, separados por comas
# (por ejemplo: telcobras.com,www.telcobras.com). En desarrollo se añaden localhost y
# 127.0.0.1. Si falta en producción, el formulario responde 503 (fail-closed).
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Chatbot (/api/chat) ---

# URL https del webhook del escenario de Make que responde al chatbot. Solo la usa el
# servidor; si falta, el chat responde chat_unavailable.
MAKE_CHAT_WEBHOOK_URL=
