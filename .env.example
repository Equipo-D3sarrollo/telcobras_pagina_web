# Copia este archivo como .env.local (desarrollo) y rellena los valores.
# En cPanel: "Setup Node.js App" > Environment variables (no hay .env.local en producción).
# No subas valores reales.

# --- Formulario de contacto (/api/contacto) ---

# Base de datos MySQL/MariaDB (cotizaciones). Solo las usa el servidor. El esquema está en
# documentacion/db/telcobras_cotizaciones.sql. El usuario solo necesita SELECT, INSERT,
# UPDATE y DELETE sobre la base. En cPanel el nombre y el usuario llevan el prefijo de la
# cuenta (por ejemplo cuenta_cotizaciones). Si falta alguna (salvo DB_PORT), el formulario
# responde 503.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telcobras_cotizaciones
DB_USER=telcobras_app
DB_PASSWORD=cambia-esta-contrasena

# Clave secreta de Cloudflare Turnstile para validar el token en el servidor.
# Si falta, el formulario responde 503 (fail-closed).
TURNSTILE_SECRET_KEY=

# Clave pública (site key) de Cloudflare Turnstile para dibujar el widget en el navegador.
# Si falta, el formulario se muestra deshabilitado con un aviso.
VITE_TURNSTILE_SITE_KEY=

# Hostnames desde los que se acepta un token de Turnstile, separados por comas
# (por ejemplo: telcobras.com,www.telcobras.com). En desarrollo se añaden localhost y
# 127.0.0.1. Si falta en producción, el formulario responde 503 (fail-closed).
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Aviso por correo de cotizaciones nuevas (fase 3) ---
# Si falta SMTP_HOST, SMTP_USER, SMTP_PASSWORD, MAIL_FROM o MAIL_TO_COTIZACIONES,
# no se envía nada: el formulario sigue guardando en MySQL y solo se registra un aviso.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TELCOBRAS Web <notificaciones@telcobras.com>"
MAIL_TO_COTIZACIONES=contabilidad@telcobras.com
PUBLIC_SITE_URL=https://telcobras.com

# --- Proxy (cPanel) ---

# Poner TRUST_PROXY=1 cuando el servidor está detrás de un proxy de confianza (cPanel con
# Apache/LiteSpeed): así el límite de envíos y el login usan la IP real del cliente
# (entrada de más a la derecha de X-Forwarded-For). Dejarlo vacío si NO hay proxy (el
# encabezado lo podría falsificar cualquiera) o si se usa Cloudflare (cf-connecting-ip).
TRUST_PROXY=

# --- Chatbot (/api/chat) ---

# URL https del webhook del escenario de Make que responde al chatbot. Solo la usa el
# servidor; si falta, el chat responde chat_unavailable. NO es obligatoria mientras el
# chat esté apagado (CHATBOT_ENABLED = false en src/lib/telcobras-data.ts).
MAKE_CHAT_WEBHOOK_URL=
